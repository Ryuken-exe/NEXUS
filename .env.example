# Used for local, non-Docker development.
DATABASE_URL=postgresql://dogfood:dogfood@localhost:5432/dogfood?schema=public

# Used by the application for signing. Replace these outside the demo.
JWT_SECRET=replace-with-a-long-random-secret
JUDGE_SIGNING_SECRET=replace-with-an-independent-long-random-secret
APP_URL=http://localhost:3000

# Optional Docker overrides. docker-compose.yml has safe defaults.
POSTGRES_USER=dogfood
POSTGRES_PASSWORD=dogfood
POSTGRES_DB=dogfood
WEB_PORT=3000